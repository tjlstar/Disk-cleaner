<UserControl x:Class="DiskCleaner.Views.DeletionProgressView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="720" Margin="28,60,28,22" VerticalAlignment="Top">
        <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding Headline}" />
        <ProgressBar Height="4"
                     Margin="0,16,0,0"
                     BorderThickness="0"
                     Background="{StaticResource BarTrackBrush}"
                     Foreground="{StaticResource AccentBrush}"
                     IsIndeterminate="True" />
        <TextBlock Margin="0,18,0,0"
                   FontWeight="SemiBold"
                   Text="{Binding CurrentName}"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock Margin="0,4,0,0"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="{Binding CurrentPath}"
                   TextWrapping="Wrap" />
        <TextBlock Margin="0,14,0,0"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="计算大小已经暂停，处理完会接着算。"
                   TextWrapping="Wrap" />
        <StackPanel Margin="0,24,0,0" Orientation="Horizontal">
            <Button Padding="16,7"
                    Style="{StaticResource ToolButton}"
                    Command="{Binding StopCommand}"
                    Content="停止" />
            <TextBlock Margin="12,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding StopHint}"
                       TextWrapping="Wrap" />
        </StackPanel>
    </StackPanel>
</UserControl>
