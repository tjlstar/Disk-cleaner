<UserControl x:Class="DiskCleaner.Views.DriveListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="36,30,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="选一个盘" FontSize="24" FontWeight="SemiBold" />

        <DockPanel Grid.Row="1" Margin="0,8,0,20" LastChildFill="True">
            <Button DockPanel.Dock="Right"
                    Style="{StaticResource ToolButton}"
                    Command="{Binding RefreshCommand}"
                    Content="刷新" />
            <TextBlock VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextWrapping="Wrap"
                       Text="本机硬盘、移动硬盘、U 盘和存储卡都在这里。网络位置和网盘不列出。插上新的盘后按「刷新」。" />
        </DockPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Drives}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="0,0,0,10"
                                Style="{StaticResource CardButton}"
                                Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           FontFamily="{StaticResource IconFont}"
                                           FontSize="26"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="&#xEDA2;" />
                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding FreeText}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                                            <Border Margin="10,0,0,0"
                                                    Padding="7,1"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource BarTrackBrush}"
                                                    CornerRadius="4"
                                                    Visibility="{Binding HasKindTag, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock FontSize="12" Foreground="{StaticResource MutedTextBrush}" Text="{Binding KindTag}" />
                                            </Border>
                                        </StackPanel>
                                    </DockPanel>
                                    <Grid Height="8" Margin="0,10,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding UsedLength}" />
                                            <ColumnDefinition Width="{Binding FreeLength}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="2" Background="{StaticResource BarTrackBrush}" CornerRadius="4" />
                                        <Border Background="{StaticResource AccentBrush}" CornerRadius="4" />
                                    </Grid>
                                    <TextBlock Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding UsageText}"
                                               ToolTip="{Binding ExactText}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource WarningTextBrush}"
                                               Text="这个盘没有回收站。删除时会先停下来问你，默认跳过。"
                                               Visibility="{Binding HasNoRecycleBin, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="没有找到可以查看的盘。"
                   Visibility="{Binding HasNoDrives, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
