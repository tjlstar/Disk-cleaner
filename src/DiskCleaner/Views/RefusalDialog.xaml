<Window x:Class="DiskCleaner.Views.RefusalDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="回收站不肯收"
        Width="560"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="White"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="24,20,24,20">
        <TextBlock FontSize="17" FontWeight="SemiBold" Text="这一项放不进回收站" />
        <TextBlock x:Name="ItemName" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="ItemPath"
                   Margin="0,2,0,0"
                   FontSize="12"
                   Foreground="{StaticResource MutedTextBrush}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="ReasonText"
                   Margin="0,8,0,0"
                   Foreground="{StaticResource WarningTextBrush}"
                   TextWrapping="Wrap" />

        <StackPanel x:Name="ChoicePanel" Margin="0,16,0,0">
            <Button x:Name="SkipButton" Style="{StaticResource ChoiceButton}" Click="OnSkip" IsDefault="True" IsCancel="True">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Text="跳过这一项（推荐）" />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="留在原来的位置，记进失败清单，也留在待删除里。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ChoiceButton}" Click="OnDeleteThis">
                <StackPanel>
                    <TextBlock Text="这一项改为永久删除" />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="删了就不能从回收站找回。还会再问你一次。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource ChoiceButton}" Click="OnDeleteRefused">
                <StackPanel>
                    <TextBlock Text="这次任务里，后面凡是回收站不肯收的，都改为永久删除" TextWrapping="Wrap" />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="能进回收站的仍然进回收站。这次任务结束就失效。还会再问你一次。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>
            <Button Margin="0" Style="{StaticResource ChoiceButton}" Click="OnStop">
                <StackPanel>
                    <TextBlock Text="停止整个任务" />
                    <TextBlock FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               Text="已经放进回收站的留在回收站里，还没处理的留在待删除里。"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Button>
        </StackPanel>

        <StackPanel x:Name="ConfirmPanel" Margin="0,16,0,0" Visibility="Collapsed">
            <Border Padding="12,10"
                    Background="#FDECEC"
                    BorderBrush="#F5C2C2"
                    BorderThickness="1"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" Foreground="#B42318" Text="确定要永久删除吗？" />
                    <TextBlock x:Name="ConfirmText" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Style="{StaticResource DangerButton}"
                        Click="OnConfirmPermanent"
                        Content="永久删除" />
                <Button x:Name="BackButton"
                        Padding="16,7"
                        Style="{StaticResource ToolButton}"
                        Click="OnBack"
                        Content="返回" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</Window>
