<UserControl x:Class="DiskCleaner.Views.ConfirmDeletionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="28,22,28,22">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="确认放入回收站" />
            <TextBlock Margin="0,10,0,0" Text="{Binding SummaryText}" TextWrapping="Wrap" />
            <TextBlock Margin="0,6,0,0"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="文件夹会连同里面的文件和子文件夹一起放进回收站。"
                       TextWrapping="Wrap" />
            <Border Margin="0,12,0,0"
                    Padding="12,8"
                    Background="#FFF7E6"
                    BorderBrush="#F5D9A8"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="{Binding HasNoRecycleBinItems, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Foreground="{StaticResource WarningTextBrush}" Text="{Binding NoRecycleBinText}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Margin="0,0,10,0"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding ConfirmCommand}"
                    Content="放入回收站" />
            <Button x:Name="CancelButton"
                    Padding="16,7"
                    Style="{StaticResource ToolButton}"
                    Command="{Binding CancelCommand}"
                    Content="取消"
                    IsCancel="True"
                    IsDefault="True" />
        </StackPanel>

        <ScrollViewer Margin="0,16,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding VisibleItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="4,8" BorderBrush="{StaticResource RowDividerBrush}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   Text="{Binding FullPath}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="16,0,4,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               Text="{Binding SizeText}"
                                               ToolTip="{Binding SizeToolTip}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Margin="0,8,0,0"
                        HorizontalAlignment="Left"
                        Style="{StaticResource BreadcrumbButton}"
                        Command="{Binding ShowAllCommand}"
                        Content="{Binding ShowAllText}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
