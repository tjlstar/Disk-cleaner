<UserControl x:Class="DiskCleaner.Views.BrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:core="clr-namespace:DiskCleaner.Core;assembly=DiskCleaner.Core"
             PreviewKeyDown="OnKeyDown"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Path bar -->
        <Border Padding="12,10,16,10" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource IconButton}"
                        Command="{Binding GoUpCommand}"
                        ToolTip="回到上一层（Backspace）"
                        Content="&#xE72B;" />
                <Button DockPanel.Dock="Right"
                        Style="{StaticResource ToolButton}"
                        Command="{Binding RecalculateCommand}"
                        ToolTip="只忘掉这一层记住的结果，重新读一遍">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="13"
                                   Text="&#xE72C;" />
                        <TextBlock Text="重新计算这一层" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right"
                        Margin="0,0,8,0"
                        Style="{StaticResource ToolButton}"
                        Command="{Binding BackToDrivesCommand}"
                        Content="换一个盘" />

                <ItemsControl Margin="6,0,12,0" VerticalAlignment="Center" ItemsSource="{Binding Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Separator"
                                           Margin="2,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           Text="/" />
                                <Button Content="{Binding Name}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource BreadcrumbButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                    <Setter Property="Cursor" Value="Arrow" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <!-- Select all, and drill into the ticked folders -->
        <DockPanel Grid.Row="1" Margin="16,10,20,6">
            <CheckBox x:Name="SelectAllBox"
                      DockPanel.Dock="Left"
                      VerticalAlignment="Center"
                      Content="全选"
                      IsThreeState="True"
                      Checked="OnSelectAllChanged"
                      Unchecked="OnSelectAllChanged"
                      Indeterminate="OnSelectAllChanged"
                      ToolTip="把这一页能勾选的项都放进待删除，或都拿出来" />
            <Button DockPanel.Dock="Left"
                    Margin="16,0,0,0"
                    Style="{StaticResource ToolButton}"
                    Command="{Binding DrillCommand}"
                    IsEnabled="{Binding CanDrill}"
                    ToolTip="把勾选的文件夹再往里展开一层，合成一张列表。每按一次往下一层">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="12"
                               Text="&#xE74B;" />
                    <TextBlock Text="下钻一层" />
                </StackPanel>
            </Button>
            <TextBlock Margin="14,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="{Binding DrillHint}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding DrillHint}" />
        </DockPanel>

        <TextBlock Grid.Row="2"
                   Margin="20,0,20,8"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="{Binding StatusText}"
                   TextWrapping="Wrap" />

        <!-- Current level -->
        <ListBox x:Name="EntryList"
                 Grid.Row="3"
                 Background="White"
                 BorderThickness="0"
                 Padding="0"
                 HorizontalContentAlignment="Stretch"
                 ItemsSource="{Binding Rows}"
                 PreviewMouseWheel="OnListMouseWheel"
                 PreviewMouseMove="OnListMouseMove"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <EventSetter Event="MouseLeftButtonUp" Handler="OnRowClick" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="Transparent"
                                        BorderBrush="{StaticResource RowDividerBrush}"
                                        BorderThickness="0,0,0,1">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource SelectedBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding CanOpen}" Value="True">
                            <Setter Property="Cursor" Value="Hand" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="44" Margin="16,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="3*" MinWidth="180" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="24" />
                        </Grid.ColumnDefinitions>

                        <CheckBox VerticalAlignment="Center"
                                  Focusable="False"
                                  IsChecked="{Binding IsMarked, Mode=TwoWay}"
                                  IsEnabled="{Binding CanToggleMark}"
                                  ToolTip="放进待删除。勾上的文件夹可以按「下钻一层」一起展开" />

                        <TextBlock x:Name="Icon"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="16"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="{Binding Icon}" />

                        <StackPanel Grid.Column="2" Margin="0,5" VerticalAlignment="Center">
                            <DockPanel LastChildFill="True">
                                <Border DockPanel.Dock="Right"
                                        Margin="8,0,0,0"
                                        Padding="6,1"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource SelectedBrush}"
                                        CornerRadius="4"
                                        ToolTip="按「下钻一层」时会展开这个文件夹"
                                        Visibility="{Binding IsDrillTarget, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock FontSize="11" Foreground="{StaticResource AccentBrush}" Text="将展开" />
                                </Border>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Entry.FullPath}" />
                            </DockPanel>
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding PathText}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding PathText}"
                                       Visibility="{Binding ShowPath, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Margin="0,1,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="会随上面的文件夹一起删除"
                                       Visibility="{Binding IsCovered, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock x:Name="Note"
                                       Margin="0,1,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Text="{Binding Note}"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <Grid Grid.Column="3"
                              Height="10"
                              Margin="16,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding ShowBar, Converter={StaticResource BoolToVisibility}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding BarLength}" />
                                <ColumnDefinition Width="{Binding BarRestLength}" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.ColumnSpan="2" Background="{StaticResource BarTrackBrush}" CornerRadius="5" />
                            <Border Background="{StaticResource AccentBrush}" CornerRadius="5" />
                        </Grid>

                        <TextBlock x:Name="Size"
                                   Grid.Column="4"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Background="Transparent"
                                   Text="{Binding SizeText}"
                                   ToolTip="{Binding SizeToolTip}"
                                   ToolTipService.InitialShowDelay="250" />

                        <TextBlock Grid.Column="5"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Text="&#xE76C;"
                                   Visibility="{Binding CanOpen, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static core:EntryKind.Folder}">
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource FolderIconBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsSizeMuted}" Value="True">
                            <Setter TargetName="Size" Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsWarning}" Value="True">
                            <Setter TargetName="Size" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                            <Setter TargetName="Note" Property="Foreground" Value="{StaticResource WarningTextBrush}" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock HorizontalAlignment="Center"
                       FontSize="16"
                       Foreground="{StaticResource WarningTextBrush}"
                       Text="{Binding ErrorText}" />
            <TextBlock Margin="0,6,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedTextBrush}"
                       Text="可以回到上一层，或者稍后按「重新计算这一层」再试。" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource MutedTextBrush}"
                   Text="{Binding EmptyText}"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
