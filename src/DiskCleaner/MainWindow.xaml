<Window x:Class="DiskCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DiskCleaner.ViewModels"
        xmlns:views="clr-namespace:DiskCleaner.Views"
        Title="磁盘空间清理"
        Width="1240"
        Height="760"
        MinWidth="960"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="White"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="14"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DriveListViewModel}">
            <views:DriveListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:BrowserViewModel}">
            <views:BrowserView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
        <views:PendingPanel Grid.Column="1" DataContext="{Binding Pending}" />
    </Grid>
</Window>
